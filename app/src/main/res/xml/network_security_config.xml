<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow the still-in-creation backend domain once it has a certificate -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">24hrs.myjournalplus.com</domain>
    </domain-config>
</network-security-config>
